# ======================================================================
# MOSHINA BOR — production environment (docker compose)
# Copy to infrastructure/deployment/.env and fill in. NEVER commit the filled file.
# Generate each secret with:  openssl rand -hex 32   (URL-safe: passwords are embedded in DATABASE_URL/REDIS_URL)
# ======================================================================

DEPLOYMENT_ENVIRONMENT=production
APP_VERSION=1.0.0                                   # set to the git SHA/tag being deployed (deploy.sh does this)
REGISTRY=moshina-bor

# Public URLs
API_PUBLIC_URL=https://api.moshinabor.uz            # mobile API origin: file URLs + SMS delivery callbacks (must match the app build)
CORS_ORIGINS=https://admin.moshinabor.uz            # comma-separated; never "*"
ADMIN_SERVER_NAME=admin.moshinabor.uz
HTTP_BIND=127.0.0.1:8080                            # put your TLS reverse proxy (Caddy/nginx/LB) in front
TRUST_PROXY=2                                       # proxies between client and API: edge proxy + admin nginx
SWAGGER_ENABLED=false
LOG_LEVEL=info

# Database / cache
POSTGRES_USER=moshina
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=moshina_bor
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# Secrets (min 32 chars, all different)
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=
OTP_PEPPER=

# ---- SMS (REQUIRED for sign-in) ----
# Primary provider for +998 numbers: eskiz (https://eskiz.uz). The OTP text must match a template approved in your Eskiz cabinet.
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Secret appended to delivery-report callback URLs (min 24 chars)
SMS_CALLBACK_SECRET=
# Optional custom texts; must contain {code} and match the approved template exactly.
SMS_OTP_TEMPLATE_UZ=
SMS_OTP_TEMPLATE_RU=
SMS_OTP_TEMPLATE_EN=
# Optional: deliver to non-Uzbek numbers through Twilio
SMS_INTERNATIONAL_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ---- Push ----
# Optional Expo access token (enable "Enhanced push security" in your Expo account)
EXPO_ACCESS_TOKEN=

# ---- Backups ----
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Backups are encrypted (GnuPG AES-256). Create the passphrase file before the first start:
#   mkdir -p secrets && openssl rand -base64 48 > secrets/backup_passphrase && chmod 600 secrets/backup_passphrase
BACKUP_PASSPHRASE_PATH=./secrets/backup_passphrase
BACKUP_REQUIRE_ENCRYPTION=true

# ---- Edge proxy (optional, --profile edge) ----
API_DOMAIN=api.moshinabor.uz
ADMIN_DOMAIN=admin.moshinabor.uz
ADMIN_ALLOWED_IPS="203.0.113.10/32"               # office/VPN egress IPs (space-separated, quoted)
ACME_EMAIL=ops@moshinabor.uz

# ---- Monitoring (monitor.sh) ----
ALERT_WEBHOOK_URL=
