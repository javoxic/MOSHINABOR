# ======================================================================
# MOSHINA BOR — STAGING environment (docker compose)
# Use a SEPARATE host or at least a separate directory/project:
#   cp .env.staging.example .env.staging
#   docker compose --env-file .env.staging -p moshina-bor-staging --profile edge up -d
# Staging must never contain production data or production secrets.
# Generate every secret freshly:  openssl rand -base64 48
# ======================================================================

DEPLOYMENT_ENVIRONMENT=staging
APP_VERSION=staging-REPLACE_WITH_GIT_SHA
REGISTRY=moshina-bor

# Public hostnames (DNS A/AAAA records → this host). Admin is only reachable from ADMIN_ALLOWED_IPS.
API_DOMAIN=staging.moshinabor.uz
ADMIN_DOMAIN=admin-staging.moshinabor.uz
ADMIN_ALLOWED_IPS="203.0.113.10/32 198.51.100.0/24"
ACME_EMAIL=ops@moshinabor.uz
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

API_PUBLIC_URL=https://staging.moshinabor.uz
CORS_ORIGINS=https://admin-staging.moshinabor.uz
HTTP_BIND=127.0.0.1:8081          # internal admin/nginx port; the edge proxy is the only public entry
TRUST_PROXY=2                       # client → Caddy → admin nginx → API
LOG_LEVEL=info
# SWAGGER_ENABLED is off by default (NODE_ENV=production); /docs is also blocked at the edge.

# Separate database / cache (own volumes via the compose project name)
POSTGRES_USER=moshina_staging
POSTGRES_PASSWORD=
POSTGRES_DB=moshina_bor_staging
REDIS_PASSWORD=

# Secrets — unique to staging, never reuse production values
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=
OTP_PEPPER=
SMS_CALLBACK_SECRET=

# SMS — use a separate Eskiz sender/account or the same account with a low balance limit.
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_INTERNATIONAL_PROVIDER=none

# Push — a separate EAS project or the pilot app variant (bundle id uz.moshinabor.app.pilot)
EXPO_ACCESS_TOKEN=

# Encrypted backups (separate passphrase from production)
BACKUP_DIR=./backups-staging
BACKUP_PASSPHRASE_PATH=./secrets/staging_backup_passphrase
BACKUP_REQUIRE_ENCRYPTION=true
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# Monitoring (monitor.sh)
ALERT_WEBHOOK_URL=
