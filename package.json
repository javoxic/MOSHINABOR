{
  "name": "moshina-bor",
  "private": true,
  "version": "1.0.0",
  "description": "MOSHINA BOR \u2014 automotive maintenance management platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter @moshina/shared --filter @moshina/validation --filter @moshina/api-types run build",
    "build": "pnpm build:packages && pnpm --filter @moshina/backend run build && pnpm --filter @moshina/admin run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0",
      "postcss": "^8.5.23",
      "decode-uri-component": "^0.5.1",
      "deepmerge-ts": "^8.0.0",
      "glob@>=9.0.0 <=14.0.1": "^14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
