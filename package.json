{
  "name": "moshina-bor",
  "private": true,
  "version": "1.0.0",
  "description": "MOSHINA BOR — automotive maintenance management platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter @moshina/shared --filter @moshina/validation --filter @moshina/api-types run build",
    "build": "pnpm build:packages && pnpm --filter @moshina/backend run build && pnpm --filter @moshina/admin run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
