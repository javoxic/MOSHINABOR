# =====================================================================
# MOSHINA BOR — local development environment for the backend.
# Copy to backend/.env. Production variables: infrastructure/deployment/.env.production.example
# =====================================================================
NODE_ENV=development
PORT=3000
PROCESS_ROLE=all                 # all | api | worker
LOG_LEVEL=info
TRUST_PROXY=1                    # number of reverse proxies in front of the API (0 if none)
SWAGGER_ENABLED=true             # /docs and /docs/openapi.json
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

DATABASE_URL=postgresql://moshina:moshina_dev@localhost:5432/moshina_bor?schema=public
REDIS_URL=redis://localhost:6379

# Secrets: >= 32 chars each, all different (openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=
OTP_PEPPER=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_SESSION_TTL_HOURS=12

# OTP policy
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_PHONE_PER_DAY=10
OTP_MAX_PER_IP_PER_HOUR=20
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=10

# SMS: eskiz | twilio | log  ("log" = development only, refused when NODE_ENV=production;
# it writes the code to the server log and DOES NOT deliver any SMS)
SMS_PROVIDER=log
SMS_INTERNATIONAL_PROVIDER=none  # none | twilio (for non +998 numbers)
SMS_CALLBACK_SECRET=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Optional custom OTP texts ({code} placeholder); must match approved provider templates
SMS_OTP_TEMPLATE_UZ=
SMS_OTP_TEMPLATE_RU=
SMS_OTP_TEMPLATE_EN=

# Push (optional Expo access token)
EXPO_ACCESS_TOKEN=

STORAGE_DIR=./storage
ACCOUNT_DELETION_GRACE_DAYS=30
