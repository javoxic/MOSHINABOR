# Base URL of the MOSHINA BOR API reachable from the device (no trailing slash).
# Android emulator → http://10.0.2.2:3000 ; iOS simulator → http://localhost:3000 ; device → your LAN IP or HTTPS URL
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Expo / EAS project id (required for push notification tokens and EAS builds)
EAS_PROJECT_ID=
# Store identifiers
IOS_BUNDLE_IDENTIFIER=uz.moshinabor.app
ANDROID_PACKAGE=uz.moshinabor.app
# Path to google-services.json (FCM credentials for Android push), provided by EAS secret file
GOOGLE_SERVICES_JSON=
