{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.moshinabor.uz",
        "APP_VARIANT": "pilot"
      },
      "environment": "development"
    },
    "pilot": {
      "distribution": "internal",
      "channel": "pilot",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.moshinabor.uz",
        "APP_VARIANT": "pilot"
      },
      "environment": "preview"
    },
    "pilot-testflight": {
      "distribution": "store",
      "channel": "pilot",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.moshinabor.uz",
        "APP_VARIANT": "pilot"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": false,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.moshinabor.uz"
      },
      "environment": "production"
    }
  },
  "submit": {
    "pilot-testflight": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    },
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    }
  }
}
