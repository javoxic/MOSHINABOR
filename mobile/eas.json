{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://staging.moshinabor.uz", "APP_VARIANT": "pilot" }
    },
    "pilot": {
      "distribution": "internal",
      "channel": "pilot",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_API_URL": "https://staging.moshinabor.uz", "APP_VARIANT": "pilot" }
    },
    "pilot-testflight": {
      "distribution": "store",
      "channel": "pilot",
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://staging.moshinabor.uz", "APP_VARIANT": "pilot" }
    },
    "production": {
      "autoIncrement": false,
      "channel": "production",
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.moshinabor.uz" }
    }
  },
  "submit": {
    "pilot-testflight": {
      "android": { "track": "internal" },
      "ios": {}
    },
    "production": {
      "android": { "track": "internal" },
      "ios": {}
    }
  }
}
